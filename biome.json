{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "files": {
    "includes": [
      "life/static/**/*.js"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "overrides": [
    {
      "includes": [
        "life/static/app.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/architecture.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off",
            "noUnusedVariables": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/city-live.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/city-plan.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/exp1.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          },
          "style": {
            "useTemplate": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/layout.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedFunctionParameters": "off"
          },
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/moodboard.js"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    },
    {
      "includes": [
        "life/static/rulers.js"
      ],
      "linter": {
        "rules": {
          "suspicious": {
            "useIterableCallbackReturn": "off"
          }
        }
      }
    }
  ]
}
